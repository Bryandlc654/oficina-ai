{
  "name": "ai-virtual-office",
  "version": "0.1.0",
  "private": true,
  "description": "Private AI multi-agent virtual office",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts",
    "dev:next": "next dev",
    "clean": "node -e \"const fs=require('fs');for(const d of ['.next','.next-dev'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "start:next": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "bcryptjs": "3.0.3",
    "bullmq": "6.5.2",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "dotenv": "^16.6.1",
    "ioredis": "6.0.0",
    "jose": "6.2.14",
    "lucide-react": "1.65.0",
    "next": "15.5.28",
    "prisma": "6.19.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.187.0",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
