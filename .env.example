# ---------------------------------------------------------------------------
# Database (MySQL 8+)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://office:office@localhost:3306/ai_virtual_office"

# ---------------------------------------------------------------------------
# Redis (BullMQ queues + realtime pub/sub)
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Security
# AUTH_SECRET: random 32+ chars. Generate with: openssl rand -base64 48
# ENCRYPTION_KEY: base64-encoded 32 bytes used for AES-256-GCM at rest.
#   Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-secret"
ENCRYPTION_KEY="replace-with-base64-32-bytes"

# ---------------------------------------------------------------------------
# Initial administrator (created by `npm run db:seed`)
# There is no public registration. Change the password after first login.
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@office.local"
ADMIN_PASSWORD="change-me-now"
ADMIN_PASSWORD_RESET="false"
ADMIN_NAME="Director General"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WORKER_CONCURRENCY="2"
SUBTASK_CONCURRENCY="2"

# ---------------------------------------------------------------------------
# OpenRouter (optional, free models). The app also accepts the encrypted key
# configured from /ai; the environment key is used only as a fallback.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
OPENROUTER_DEFAULT_MODEL="cohere/north-mini-code:free"

# ---------------------------------------------------------------------------
# Local LLM provider (optional)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
